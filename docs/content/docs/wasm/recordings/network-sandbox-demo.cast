[0.883, "o", "\u001b[1m=== Network Policy Sandbox Demo ===\u001b[0m\r\n\r\n\u001b[2mPlugin:\u001b[0m  net-http-test.wasm\r\n\u001b[2mPayload:\u001b[0m url + method passed as ToolCall arguments\r\n\u001b[2mResult:\u001b[0m  plugin writes 'allowed' or 'denied' into local_state\r\n\r\n"]
[0.008, "o", "\u001b[1;36m--- Scenario 1: no policy (deny-by-default)\u001b[0m\r\n"]
[3.352, "o", "\u001b[2m2026-08-07T16:26:41.245258Z\u001b[0m \u001b[33m WARN\u001b[0m \u001b[2mcpex_wasm_host::sandbox_manager\u001b[0m\u001b[2m:\u001b[0m no explicit max_execution_time_ms configured — using default 5000ms \u001b[3mplugin\u001b[0m\u001b[2m=\u001b[0mnet-deny-all\r\n"]
[0.002, "o", "  \u001b[2m[DENY expected]\u001b[0m GET    https://example.com/\r\n  \u001b[31m→ DENY \u001b[0m\r\n\r\n\u001b[1;36m--- Scenario 2: host allowlist  allowed=[example.com]\u001b[0m\r\n"]

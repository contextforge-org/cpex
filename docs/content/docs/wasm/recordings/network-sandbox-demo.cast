[0.880, "o", "\u001b[1m=== Network Policy Sandbox Demo ===\u001b[0m\r\n\r\n\u001b[2mPlugin:\u001b[0m  net-sandbox-demo.wasm (registered 7 times with different policies)\r\n\u001b[2mPayload:\u001b[0m url + method passed as ToolCall arguments\r\n\u001b[2mResult:\u001b[0m  plugin writes 'allowed' or 'denied' into local_state\r\n\r\n"]
[24.379, "o", "\u001b[1;36m--- Scenario 1: no policy (deny-by-default)\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m2026-08-11T16:32:49.468336Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2mcpex_wasm_host::sandbox_manager\u001b[0m\u001b[2m:\u001b[0m net-sandbox-demo: GET https://example.com/ \u001b[3mplugin\u001b[0m\u001b[2m=\u001b[0mnet-deny-all\r\n"]

[0.000, "o", "  \u001b[2m[DENY expected]\u001b[0m GET    https://other.com/\r\n  \u001b[31m→ DENY \u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[1;36m--- Scenario 3: wildcard host  allowed=[*.example.com]\u001b[0m\r\n"]
